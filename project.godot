; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="Uzi Rush"
config/description="PSX first-person dual-uzi arena shooter. Endless waves, roguelike item drafts."
run/main_scene="res://scenes/main.tscn"
config/features=PackedStringArray("4.7", "GL Compatibility")
boot_splash/bg_color=Color(0.05, 0.03, 0.1, 1)
boot_splash/show_image=false
config/icon="res://icon.svg"

[autoload]

Game="*res://scripts/autoload/game.gd"
Sfx="*res://scripts/autoload/sfx.gd"

[display]

window/size/viewport_width=854
window/size/viewport_height=480
window/size/window_width_override=1280
window/size/window_height_override=720
window/stretch/mode="viewport"
window/stretch/aspect="expand"

[gui]

theme/default_font_antialiasing=0

[physics]

common/physics_ticks_per_second=60

[rendering]

textures/canvas_textures/default_texture_filter=0
renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
anti_aliasing/quality/msaa_3d=0
environment/defaults/default_clear_color=Color(0.05, 0.03, 0.1, 1)

[shader_globals]

psx_light_dir={
"type": "vec3",
"value": Vector3(0.35, -0.8, -0.5)
}
psx_light_color={
"type": "color",
"value": Color(1, 0.82, 0.62, 1)
}
psx_ambient={
"type": "color",
"value": Color(0.42, 0.34, 0.5, 1)
}
psx_fog_color={
"type": "color",
"value": Color(0.95, 0.55, 0.45, 1)
}
psx_fog_range={
"type": "vec2",
"value": Vector2(30, 110)
}
psx_snap={
"type": "vec2",
"value": Vector2(214, 120)
}
psx_affine={
"type": "float",
"value": 1.0
}
